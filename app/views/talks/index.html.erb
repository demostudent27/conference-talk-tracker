<% content_for :title, t("foundation_domain.entities.talks.index.title") %>

<section class="py-10 sm:py-14">
  <header class="mb-8">
    <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= t("foundation_domain.entities.talks.index.heading") %></h1>
    <p class="mt-2 text-sm/6 text-base-content/70"><%= t("foundation_domain.entities.talks.index.lede") %></p>
  </header>

  <% if @talks.load.any? %>
    <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
      <table class="table">
        <caption class="sr-only"><%= t("foundation_domain.entities.talks.index.caption") %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t("foundation_domain.entities.talks.index.descriptor_label") %></th>
          </tr>
        </thead>
        <tbody>
          <% @talks.each do |talk| %>
            <tr>
              <td><%= talk.title %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/foundation_pagination", pagy: @pagy %>
  <% elsif @pagy.count.positive? %>
    <section class="rounded-box border border-dashed border-base-300 bg-base-100 px-6 py-12 text-center">
      <h2 class="text-lg font-semibold"><%= t("foundation_domain.pagination.empty.heading") %></h2>
      <p class="mt-2 text-sm/6 text-base-content/70"><%= t("foundation_domain.pagination.empty.body") %></p>
      <%= link_to t("foundation_domain.pagination.empty.action"), talks_path,
        class: "btn btn-primary mt-5" %>
    </section>
    <%= render "shared/foundation_pagination", pagy: @pagy %>
  <% else %>
    <section class="rounded-box border border-dashed border-base-300 bg-base-100 px-6 py-12 text-center">
      <h2 class="text-lg font-semibold"><%= t("foundation_domain.entities.talks.empty.heading") %></h2>
      <p class="mt-2 text-sm/6 text-base-content/70"><%= t("foundation_domain.entities.talks.empty.body") %></p>
    </section>
  <% end %>
</section>
